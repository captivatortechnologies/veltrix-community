{
  "name": "veltrix-community",
  "version": "0.1.0",
  "private": true,
  "description": "Veltrix Community Edition — open-source Security-as-Code platform",
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter ./server --filter ./client --filter ./shared --filter \"./packages/*\" build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "dev": "docker compose up",
    "dev:down": "docker compose down",
    "db:generate": "pnpm --filter ./server prisma:generate",
    "db:migrate": "pnpm --filter ./server prisma:migrate",
    "secrets:scan": "gitleaks detect --no-git --redact -c .gitleaks.toml --source ."
  },
  "keywords": [
    "security-as-code",
    "devsecops",
    "configuration-management",
    "pipeline",
    "self-hosted"
  ],
  "//overrides": "Security remediations for transitive deps not directly ours (Dependabot Bundle A). Version-ranged selectors touch only the vulnerable instance and leave safe majors alone.",
  "pnpm": {
    "overrides": {
      "find-my-way": ">=9.7.0",
      "fast-uri@>=3.0.0 <3.1.5": "3.1.5",
      "fast-uri@>=4.0.0 <4.1.2": "4.1.2",
      "tar@>=7.5.0 <7.5.21": "7.5.21",
      "brace-expansion@>=1.0.0 <1.1.18": "1.1.18",
      "brace-expansion@>=5.0.0 <5.0.9": "5.0.9",
      "@opentelemetry/core@>=2.0.0 <2.8.0": "2.8.0",
      "postcss@>=8.0.0 <8.5.23": "8.5.23",
      "adm-zip": ">=0.6.0"
    }
  }
}
